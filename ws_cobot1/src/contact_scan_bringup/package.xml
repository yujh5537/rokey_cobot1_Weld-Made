<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>contact_scan_bringup</name>
  <version>0.1.0</version>
  <description>접촉 탐색 시스템의 launch 와 입력원별 파라미터(sim.yaml, real.yaml). 소유: 현지 (T05)</description>
  <maintainer email="yujh5537@users.noreply.github.com">yujh5537</maintainer>
  <license>Apache-2.0</license>

  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>ament_index_python</exec_depend>
  <!-- 자체 노드 패키지(contact_detector 등)는 의존으로 걸지 않는다.
       launch 가 설치된 패키지만 골라 띄우므로, 아직 없는 패키지가 있어도 빌드·실행된다. -->

  <test_depend>python3-pytest</test_depend>
  <test_depend>python3-yaml</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
