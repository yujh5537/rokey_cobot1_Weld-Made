        <mxCell id="c21" value="업무 관리 — REST (React ↔ Spring)" style="text;html=1;align=left;verticalAlign=middle;fontSize=13;fontColor=#33465C;" vertex="1" parent="1">
          <mxGeometry x="980" y="352" width="770" height="22" as="geometry"/>
