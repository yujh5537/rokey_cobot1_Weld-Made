        <mxCell id="c24" value="" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FAEFF7;strokeColor=#A05195;strokeWidth=5;" vertex="1" parent="1">
          <mxGeometry x="1806" y="230" width="64" height="26" as="geometry"/>
        </mxCell>
        <mxCell id="c25" value="웹 PC — Ubuntu 24.04 · Mosquitto · FastAPI · PostgreSQL 16 · Spring Boot · React·Three.js (구성 확정)" style="text;html=1;align=left;verticalAlign=middle;fontSize=13;fontColor=#33465C;" vertex="1" parent="1">
          <mxGeometry x="1884" y="232" width="1130" height="22" as="geometry"/>
        </mxCell>
        <mxCell id="c26" value="" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#EFF1FB;strokeColor=#5566B5;strokeWidth=5;" vertex="1" parent="1">
          <mxGeometry x="1806" y="270" width="64" height="26" as="geometry"/>
        </mxCell>
        <mxCell id="c27" value="메인 PC (= 제어 PC) — Ubuntu 24.04 · ROS 2 Jazzy · 자체 노드 5개 + 제공 드라이버 · contact_scan_interfaces 패키지" style="text;html=1;align=left;verticalAlign=middle;fontSize=13;fontColor=#33465C;" vertex="1" parent="1">
          <mxGeometry x="1884" y="272" width="1130" height="22" as="geometry"/>
        </mxCell>
        <mxCell id="c28" value="" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#EEF7F5;strokeColor=#2E8B7A;strokeWidth=5;" vertex="1" parent="1">
          <mxGeometry x="1806" y="310" width="64" height="26" as="geometry"/>
        </mxCell>
        <mxCell id="c29" value="로봇 컨트롤러 — M0609 (DRCF · DART 2.12.1) · RG2 · 무센서 탐침 팁 · 배치 가이드/스토퍼" style="text;html=1;align=left;verticalAlign=middle;fontSize=13;fontColor=#33465C;" vertex="1" parent="1">
          <mxGeometry x="1884" y="312" width="1130" height="22" as="geometry"/>
        </mxCell>
        <mxCell id="c30" value="&lt;b&gt;읽는 법&lt;/b&gt; &amp;nbsp; 왼쪽 입력 → 가운데 처리 → 오른쪽 출력 · Topic = sub/pub · Service = 요청/응답 · Action = 목표/피드백/결과/취소 · 점선 포트 = 검토안" style="text;html=1;align=left;verticalAlign=middle;fontSize=12;fontColor=#33465C;" vertex="1" parent="1">
          <mxGeometry x="1804" y="352" width="1210" height="22" as="geometry"/>
        </mxCell>
        <mxCell id="c31" value="&lt;font color=&quot;#8A6A3A&quot;&gt;살구 마름모 = 판단&lt;/font&gt; · 회색 머리띠 = 제공 패키지(설치·설정 사용) · 테두리 없는 머리띠(React)는 사람이 보는 자리 · 점선 상자 = 설명 쪽지" style="text;html=1;align=left;verticalAlign=middle;fontSize=12;fontColor=#33465C;" vertex="1" parent="1">
          <mxGeometry x="1804" y="374" width="1210" height="22" as="geometry"/>
        </mxCell>
        <mxCell id="c32" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FAEFF7;strokeColor=#A05195;strokeWidth=7;arcSize=2;" vertex="1" parent="1">
          <mxGeometry x="60" y="420" width="4760" height="1536" as="geometry"/>
        </mxCell>
        <mxCell id="c33" value="웹 PC · Mosquitto + FastAPI + Spring Boot + PostgreSQL + React·Three.js (4.7 · 구성 확정)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#A05195;strokeColor=#A05195;strokeWidth=1;fontSize=17;fontStyle=1;fontColor=#FFFFFF;align=center;verticalAlign=middle;arcSize=8;" vertex="1" parent="1">
          <mxGeometry x="86" y="440" width="1500" height="44" as="geometry"/>
        </mxCell>
        <mxCell id="c34" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EFF1FB;strokeColor=#5566B5;strokeWidth=7;arcSize=2;" vertex="1" parent="1">
          <mxGeometry x="60" y="2176" width="4760" height="2370" as="geometry"/>
        </mxCell>
        <mxCell id="c35" value="메인 PC (= 제어 PC) · Ubuntu 24.04 / ROS 2 Jazzy · 자체 노드 5개 + 제공 드라이버 · 로봇 베이스는 작업대에 고정" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#5566B5;strokeColor=#5566B5;strokeWidth=1;fontSize=17;fontStyle=1;fontColor=#FFFFFF;align=center;verticalAlign=middle;arcSize=8;" vertex="1" parent="1">
          <mxGeometry x="86" y="2196" width="1500" height="44" as="geometry"/>
        </mxCell>
        <mxCell id="c36" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EEF7F5;strokeColor=#2E8B7A;strokeWidth=7;arcSize=2;" vertex="1" parent="1">
          <mxGeometry x="60" y="4766" width="4760" height="900" as="geometry"/>
        </mxCell>
        <mxCell id="c37" value="로봇 컨트롤러 (Doosan M0609 · DART 2.12.1 · DRCF) · RG2 · 무센서 탐침 팁 · 배치 가이드" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#2E8B7A;strokeColor=#2E8B7A;strokeWidth=1;fontSize=17;fontStyle=1;fontColor=#FFFFFF;align=center;verticalAlign=middle;arcSize=8;" vertex="1" parent="1">
          <mxGeometry x="86" y="4786" width="1500" height="44" as="geometry"/>
        </mxCell>
        <mxCell id="c38" value="&lt;b style=&quot;font-size:16px&quot;&gt;MQTT · 명령 계약 — 설계 설명 (실행 노드 아님)&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;명령&lt;/b&gt; cmd/scan/start → /scan/run Action · cmd/scan/home → /scan/home Action · cmd/scan/resume → /scan/resume Action(초안 · 이름/방식 TBD) · cmd/scan/stop → /scan/stop Service · cmd/scan/set_config → /scan/set_config Service · 구독은 cmd/scan/+ · request_id / scan_id / session_id / 시각 포함 · 중복·만료 명령 검사 · retain=false&lt;br&gt;&lt;b&gt;응답·전달&lt;/b&gt; cmd/ack = 접수/거절 · 완료 = scan/result 또는 scan/command_result(홈 · 재시작 등) · 이벤트 = contact/event · safety/status · 텔레메트리 = robot/sample(다운샘플) · robot/status · scan/state · scan/log&lt;br&gt;&lt;b&gt;접수 ≠ 완료&lt;/b&gt; 작업 중지 접수와 실제 정지 완료(robot/status)를 구분 · 작업 중지는 홈 복귀·재시작을 자동 실행하지 않음(4.5.1) · 재시작은 새 작업 시작과 구분(4.4.8)&lt;br&gt;&lt;b&gt;검토안 (점선 · MVP 밖)&lt;/b&gt; cmd/scan/calibrate → /scan/calibrate Action · scan/calibration/result — 자동 캘리브레이션은 환경 세팅 후 범위 검토(6장) · 기준값 이력 저장(calibration_result)이 자동 캘리브레이션 채택을 뜻하지 않음&lt;br&gt;&lt;b&gt;비동기&lt;/b&gt; ROS executor · MQTT 네트워크 루프 · FastAPI asyncio 사이 안전한 큐 인계 · QoS/주기/만료/재전송/저장 확인 정책은 계약에서 확정 (위험 10)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFDF6;strokeColor=#C2A57C;strokeWidth=1.4;dashed=1;dashPattern=6 4;fontSize=14;fontColor=#4A3620;align=left;verticalAlign=top;spacingLeft=12;spacingTop=10;spacingRight=10;arcSize=4;" vertex="1" parent="1">
          <mxGeometry x="3340" y="1336" width="1340" height="480" as="geometry"/>
        </mxCell>
        <mxCell id="c39" value="&lt;b style=&quot;font-size:16px&quot;&gt;contact_scan_interfaces — 공통 정의 패키지 (실행 노드 아님)&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;msg&lt;/b&gt; RobotSample · RobotStatus · ScanState · ScanResult · ScanLog · ContactEvent · SafetyStatus · WebHeartbeat · (CalibrationResult 검토안)&lt;br&gt;&lt;b&gt;srv&lt;/b&gt; StopRobot · StopScan · TareForce · SetConfig &amp;nbsp; &lt;b&gt;action&lt;/b&gt; RunScan · ExecuteMotion · ReturnHome · Resume(이름 TBD) · (Calibrate 검토안)&lt;br&gt;RobotSample: pose / wrench / pose_stamp / force_stamp / frame_id / sample_id / valid — 같은 메시지라도 동시 취득으로 간주하지 않음 · sample_id는 robot_manager 발급&lt;br&gt;ScanState: scan_id / phase / direction / progress(n/4) / motion_id — motion_id는 scan_manager 발급, ExecuteMotion goal과 ContactEvent에 같은 값&lt;br&gt;ExecuteMotion: Goal {scan_id, motion_id, operation, target, direction, speed, max_distance, timeout} · Result/Feedback {정지 시점 pose, 종료 사유} — 중단 위치 기록의 출처&lt;br&gt;SafetyStatus: level / reason_code / stop_required / latched — latched면 재시작 거절 · 해제 조건 TBD&lt;br&gt;ContactEvent: event_id / scan_id / motion_id / sample_id / type / pose / wrench / stamps — 판정 좌표 ≠ 정지 완료 좌표&lt;br&gt;ScanResult: scan_id / 성공·실패 / 유효 항목 / W·L·H / 꼭짓점 8 / 모서리 12 / 경로 후보 4(시작·끝·길이) / 설정 스냅샷 — 미측정값을 0으로 넣지 않음&lt;br&gt;단위 m · rad · N · N·m (웹은 mm) · 프레임(base_link · workpiece_fixture 가칭)은 환경 세팅 후 확정 · 필드·enum·오류 코드는 구현 전 계약 확정 (4.7)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFDF6;strokeColor=#C2A57C;strokeWidth=1.4;dashed=1;dashPattern=6 4;fontSize=14;fontColor=#4A3620;align=left;verticalAlign=top;spacingLeft=12;spacingTop=10;spacingRight=10;arcSize=4;" vertex="1" parent="1">
          <mxGeometry x="3340" y="4076" width="1340" height="330" as="geometry"/>
        </mxCell>
        <mxCell id="c40" value="&lt;b style=&quot;font-size:16px&quot;&gt;BRD v3.0.0 반영 사항 / 미확정 사항 — 2026-09-18&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;① 형식&lt;/b&gt; 한 페이지 · PC 경계 · 입력 → 처리 → 출력 카드 · 갈래 색 (v1.3 배치 그대로). &amp;nbsp;&lt;b&gt;② MVP&lt;/b&gt; 원점 정렬·축 평행 배치한 단일 직육면체 · 5점(윗면 1 + 모서리 4) · 외곽 엣지·경로 후보 4개 Must · 지지면 투영 직육면체 · 합격 ±3 mm(이후 ±1 mm) · 실제 용접 이음으로 판정하지 않음.&lt;br&gt;&lt;b&gt;③ 명령 4개 독립&lt;/b&gt; 작업 시작 · 작업 중지 · 안전복귀(홈위치 = 시작위치 · 작업대 원점과 별개) · 재시작(기존 측정값 유지 · 중단 위치부터) — 중지는 홈/재시작을 자동 실행하지 않음. 방향별 원점 복귀와 홈 안전복귀는 구분.&lt;br&gt;&lt;b&gt;④ 접촉 판정 B(robot_force)&lt;/b&gt; 기준값 대비 임계 3~5 N · z 급강하 0.5 mm · 연속 3회 · 과대 외력 30 N · 하강량 제한 5 mm · 편향 보정 √(2rδ−δ²)+v·지연 — 모두 설계 출발값, 실측 조정. A(RG2 폭 변화)는 구현·실험 제외. sim 입력원은 Virtual Mode 개발용 (힘 제어 미동작 가능).&lt;br&gt;&lt;b&gt;⑤ 정지&lt;/b&gt; 접촉/엣지 · 안전 이상 정지는 메인 PC 내부 · 웹 정지는 MQTT 경유 소프트웨어 요청 · 접수 ≠ 정지 완료 · 순응·힘 제어 해제 finally 보장 · TP E-Stop · 충돌 감지를 대체하지 않음.&lt;br&gt;&lt;b&gt;⑥ 저장&lt;/b&gt; 메인 PC result_store 원본·진행 기록(재시작용) · FastAPI가 scan_result / scan_event / calibration_result 쓰기 · Spring은 업무 CRUD · 이력 조회 · MQTT 전달 확인 ≠ DB 커밋.&lt;br&gt;&lt;b&gt;⑦ 검토안 (점선 · MVP 밖)&lt;/b&gt; 자동 캘리브레이션 Action · 결과 — 환경 세팅 후 범위 검토.&lt;br&gt;&lt;b&gt;⑧ 환경 세팅 후 확정 (6장)&lt;/b&gt; 작업대 원점·축 · z=0 지지면 · Base 변환 · TCP · 홈 좌표 · 홈 복귀 경로 · 재접근 절차 · 재시작 허용 조건 · 래치 해제 · 최신성/HB 만료 · 브라우저 단절 · 재전송/저장 확인. API 노출(stop · set_external_force_reset)은 매뉴얼[E10] / 소스[E18] / 실PC[E19] 확인 수준을 구분.&lt;br&gt;&lt;b&gt;⑨ v1.5 정합 (2026-09-18 결정)&lt;/b&gt; ScanState 합집합 {scan_id, phase, direction, progress, motion_id} · ExecuteMotion goal에 scan_id·motion_id(scan_manager 발급) · Result에 정지 시점 pose(중단 위치 출처, scan_manager는 /robot/sample 미구독) · SafetyStatus {level, reason_code, stop_required, latched} · RobotSample frame_id·sample_id · SLIDE −z 목표 힘은 robot_manager ROS 파라미터(SetConfig로 변경) · ContactEvent·ScanResult 전체 필드 표기.&lt;br&gt;&lt;b&gt;MVP 이후&lt;/b&gt; 회전 허용 · 변당 2점 · 마커 선 긋기(US-08) · 곡면 · 실용접(Won't). &amp;nbsp;&lt;b&gt;상태&lt;/b&gt; 설계 산출물 · 코드 구현·실로봇 검증 완료 아님." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFDF6;strokeColor=#C2A57C;strokeWidth=1.4;dashed=1;dashPattern=6 4;fontSize=14;fontColor=#4A3620;align=left;verticalAlign=top;spacingLeft=12;spacingTop=10;spacingRight=10;arcSize=4;" vertex="1" parent="1">
          <mxGeometry x="200" y="4906" width="2910" height="620" as="geometry"/>
        </mxCell>
