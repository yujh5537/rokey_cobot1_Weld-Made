          <mxGeometry x="1790" y="190" width="1240" height="214" as="geometry"/>
        </mxCell>
        <mxCell id="c23" value="두꺼운 테두리 = 그 노드가 도는 컴퓨터" style="text;html=1;align=left;verticalAlign=middle;fontSize=14;fontColor=#12294D;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="1804" y="198" width="900" height="22" as="geometry"/>
