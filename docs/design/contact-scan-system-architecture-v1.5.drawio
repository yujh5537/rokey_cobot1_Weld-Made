        <mxCell id="c279" value="&lt;b&gt;/robot/sample · /robot/status&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:13px;&quot; color=&quot;#0B5FA5&quot;&gt;RobotSample {pose, wrench, pose_stamp, force_stamp, frame_id, sample_id, valid} · RobotStatus {connected, moving, error}&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px;&quot; color=&quot;#8A97A6&quot;&gt;pub · sample_id 발급 · 주기 TBD (50 Hz 설계 목표)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F4F6F8;strokeColor=#C2CBD5;fontSize=14;fontColor=#16202B;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;strokeWidth=1.2;arcSize=4;" vertex="1" parent="1">
