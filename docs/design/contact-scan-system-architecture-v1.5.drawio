        <mxCell id="c280" value="&lt;b&gt;두산 모션 · 힘/순응 · 조회 API&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:13px;&quot; color=&quot;#0B5FA5&quot;&gt;amovel · task_compliance_ctrl · set_desired_force · release_* · move_stop · get_* · check_position_condition&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px;&quot; color=&quot;#8A97A6&quot;&gt;제공 서비스 호출 · Python 노출 여부 [E18]/[E19] 구분&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F4F6F8;strokeColor=#C2CBD5;fontSize=14;fontColor=#16202B;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;strokeWidth=1.2;arcSize=4;" vertex="1" parent="1">
          <mxGeometry x="2770" y="3820" width="340" height="92" as="geometry"/>
        </mxCell>
        <mxCell id="c281" value="&lt;b&gt;RG2 파지 명령&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:13px;&quot; color=&quot;#0B5FA5&quot;&gt;/onrobot/sendCommand (소스 근거 [E18])&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px;&quot; color=&quot;#8A97A6&quot;&gt;→ RG2 제공 드라이버 · 실제 노드/네임스페이스 확인&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F4F6F8;strokeColor=#C2CBD5;fontSize=14;fontColor=#16202B;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;strokeWidth=1.2;arcSize=4;" vertex="1" parent="1">
