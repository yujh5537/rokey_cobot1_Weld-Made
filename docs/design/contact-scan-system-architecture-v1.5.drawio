          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="c285" value="&lt;b&gt;③&lt;/b&gt; DESCEND — amovel(−z 저속 등속 · 관성력 회피) → CONTACT 이벤트 → move_stop(DR_QSTOP) · 이벤트 pose ≠ 정지 pose (4.2.1)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#C2CBD5;strokeWidth=1.2;fontSize=14;fontColor=#16202B;align=left;verticalAlign=middle;spacingLeft=9;spacingRight=7;arcSize=4;" vertex="1" parent="1">
