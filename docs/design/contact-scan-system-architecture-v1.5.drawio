        <mxCell id="c70" value="&lt;b&gt;MQTT 구독 (필터)&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:13px;&quot; color=&quot;#0B5FA5&quot;&gt;robot/# · scan/# · contact/# · safety/#&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px;&quot; color=&quot;#8A97A6&quot;&gt;cmd/ack · scan/command_result · hb/ros · conn/ros 도 구독&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F4F6F8;strokeColor=#C2CBD5;fontSize=14;fontColor=#16202B;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;strokeWidth=1.2;arcSize=4;" vertex="1" parent="1">
