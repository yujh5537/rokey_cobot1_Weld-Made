<mxfile host="app.diagrams.net" agent="contact-scan-architecture">
  <diagram id="contact-scan-arch" name="접촉스캔 시스템 아키텍처 v1.5">
    <mxGraphModel grid="1" page="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" pageScale="1" pageWidth="850" pageHeight="1100" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="c1" value="접촉 탐색 기반 외곽 엣지·경로 후보 생성 시스템 (가칭 용접 스캔 자동화 시스템) — 시스템 아키텍처 (v1.5 · BRD v3.0.0 반영 · 인터페이스 필드 정합)" style="text;html=1;align=left;verticalAlign=middle;fontSize=34;fontColor=#12294D;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="60" y="40" width="3400" height="52" as="geometry"/>
        </mxCell>
        <mxCell id="c2" value="&lt;b&gt;BRD v3.0.0 (2026-09-18)&lt;/b&gt; 기준 · v1.3 형식·배치 유지 · v1.5 = 카드 간 필드 불일치 정합(쪽지 ⑨) · &lt;b&gt;Ubuntu 24.04 + ROS 2 Jazzy&lt;/b&gt; · 자체 ROS 2 노드 5개 + 웹 스택 5개 + 제공 드라이버·브로커·DB &amp;nbsp;|&amp;nbsp; 화살표는 &lt;b&gt;포트 한 줄 → 포트 한 줄&lt;/b&gt; · 각 카드는 &lt;b&gt;입력 → 처리 로직 → 출력&lt;/b&gt; · 인터페이스 이름/타입은 &lt;b&gt;초안(4.7)&lt;/b&gt; · 실기 검증 전 · 수치는 설계 출발값" style="text;html=1;align=left;verticalAlign=middle;fontSize=15;fontColor=#4A5666;" vertex="1" parent="1">
          <mxGeometry x="60" y="100" width="3400" height="30" as="geometry"/>
        </mxCell>
        <mxCell id="c3" value="&lt;b&gt;MVP 절차 (1.4)&lt;/b&gt; &amp;nbsp; 원점 정렬·축 평행 배치 → [작업 시작] → 무접촉 기준값(1~2 s) → 수직 하강 → z_top → +x / −x / +y / −y 밀기 → 모서리 4점(z 급강하) → 윗면 사각형 · 외곽 엣지·경로 후보 4개 → 지지면 투영 직육면체(8꼭짓점 · 12모서리) → 3D 표시 · 저장 &amp;nbsp; &lt;b&gt;KPI&lt;/b&gt; ±3 mm(이후 ±1) · 탐색 120 s · 정지 1 s · 화면 지연 200 ms · 오검출 ≤ 1/20" style="text;html=1;align=left;verticalAlign=middle;fontSize=15;fontColor=#4A5666;" vertex="1" parent="1">
          <mxGeometry x="60" y="136" width="3400" height="30" as="geometry"/>
        </mxCell>
        <mxCell id="c4" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#B7C1CC;strokeWidth=1.5;" vertex="1" parent="1">
          <mxGeometry x="60" y="190" width="1700" height="214" as="geometry"/>
        </mxCell>
        <mxCell id="c5" value="화살표 색 = 데이터 갈래 (선 하나가 갈래 하나) · 점선 = 검토안 (MVP 밖) 또는 heartbeat" style="text;html=1;align=left;verticalAlign=middle;fontSize=14;fontColor=#12294D;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="74" y="198" width="900" height="22" as="geometry"/>
        </mxCell>
        <mxCell id="c6" value="" style="endArrow=blockThin;endFill=1;endSize=8;html=1;strokeColor=#5F7FD8;strokeWidth=2.6;" edge="1" parent="1">
          <mxGeometry width="50" height="50" relative="1" as="geometry">
            <mxPoint x="74" y="237" as="sourcePoint"/>
            <mxPoint x="130" y="237" as="targetPoint"/>
          </mxGeometry>
        </mxCell>
        <mxCell id="c7" value="명령 — 작업 시작 · 작업 중지 · 안전복귀 · 재시작 · 설정 (브라우저 → FastAPI → MQTT → bridge → scan_manager)" style="text;html=1;align=left;verticalAlign=middle;fontSize=13;fontColor=#33465C;" vertex="1" parent="1">
          <mxGeometry x="140" y="226" width="770" height="22" as="geometry"/>
