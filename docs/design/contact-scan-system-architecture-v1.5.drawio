            <mxPoint x="74" y="363" as="sourcePoint"/>
            <mxPoint x="130" y="363" as="targetPoint"/>
          </mxGeometry>
        </mxCell>
        <mxCell id="c19" value="저장 — PostgreSQL (FastAPI 측정 쓰기 · Spring 업무) · 메인 PC result_store 원본" style="text;html=1;align=left;verticalAlign=middle;fontSize=13;fontColor=#33465C;" vertex="1" parent="1">
          <mxGeometry x="140" y="352" width="770" height="22" as="geometry"/>
