<mxfile host="app.diagrams.net" agent="contact-scan-node-diagram" version="24.7.8">
  <diagram id="contact-scan-node-diagram" name="접촉스캔 노드 구성도 v1.1">
    <mxGraphModel dx="0" dy="0" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2600" pageHeight="2750" math="0" shadow="0">
      <root>
