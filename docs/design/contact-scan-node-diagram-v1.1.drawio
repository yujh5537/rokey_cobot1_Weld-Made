        <mxCell id="lgn1t" value="자체 ROS 2 노드 (굵은 실선)" style="text;html=1;align=left;verticalAlign=middle;fontSize=11;fontColor=#33465C;" vertex="1" parent="1"><mxGeometry x="2175" y="152" width="200" height="30" as="geometry" /></mxCell>
