<mxfile host="app.diagrams.net"><diagram name="관제 화면 흐름"><mxGraphModel dx="1200" dy="880" grid="0" page="1" pageWidth="1260" pageHeight="880"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="t" value="관제 화면 흐름 — 1차 스캔 (07-hmi.md 3장)" style="text;html=1;fontSize=13;fontStyle=1;align=left;fontFamily=Noto Sans CJK KR, Malgun Gothic, sans-serif;" vertex="1" parent="1"><mxGeometry x="30" y="22" width="1200" height="34" as="geometry"/></mxCell><mxCell id="idle" value="대기&#10;phase = IDLE" style="rounded=1;html=1;whiteSpace=wrap;fontSize=10;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fillColor=#FFFFFF;strokeColor=#8AA4C8;fontFamily=Noto Sans CJK KR, Malgun Gothic, sans-serif;" vertex="1" parent="1"><mxGeometry x="110" y="86" width="300" height="62" as="geometry"/></mxCell><mxCell id="ack" value="접수&#10;⑤ 에 "접수" 줄 (cmd/ack)&#10;아직 시작한 것이 아니다" style="rounded=1;html=1;whiteSpace=wrap;fontSize=10;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fillColor=#FFF6E5;strokeColor=#C8881E;fontFamily=Noto Sans CJK KR, Malgun Gothic, sans-serif;" vertex="1" parent="1"><mxGeometry x="110" y="196" width="300" height="76" as="geometry"/></mxCell><mxCell id="run" value="진행&#10;PREPARING → TOP_SEARCH&#10;→ EDGE_SEARCH → GEOMETRY&#10;③ 진행도 n/4 · ⑥ 궤적 · ⑦ 로그" style="rounded=1;html=1;whiteSpace=wrap;fontSize=10;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fillColor=#FFFFFF;strokeColor=#3F8B54;fontFamily=Noto Sans CJK KR, Malgun Gothic, sans-serif;" vertex="1" parent="1"><mxGeometry x="110" y="320" width="300" height="110" as="geometry"/></mxCell><mxCell id="done" value="완료&#10;phase = DONE&#10;④ 좌표 표 · ⑥ 결과 상자" style="rounded=1;html=1;whiteSpace=wrap;fontSize=10;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fillColor=#EAF6ED;strokeColor=#3F8B54;fontFamily=Noto Sans CJK KR, Malgun Gothic, sans-serif;" vertex="1" parent="1"><mxGeometry x="520" y="300" width="290" height="76" as="geometry"/></mxCell><mxCell id="stop" value="중지&#10;STOPPING → STOPPED&#10;⑤ 완료 통지 (scan/command_result)" style="rounded=1;html=1;whiteSpace=wrap;fontSize=10;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fillColor=#F2F5F9;strokeColor=#3378C8;fontFamily=Noto Sans CJK KR, Malgun Gothic, sans-serif;" vertex="1" parent="1"><mxGeometry x="520" y="420" width="290" height="88" as="geometry"/></mxCell><mxCell id="err" value="오류&#10;phase = ERROR&#10;④ 사유 · ⑦ 로그" style="rounded=1;html=1;whiteSpace=wrap;fontSize=10;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fillColor=#FDECEC;strokeColor=#C0392B;fontFamily=Noto Sans CJK KR, Malgun Gothic, sans-serif;" vertex="1" parent="1"><mxGeometry x="520" y="552" width="290" height="76" as="geometry"/></mxCell><mxCell id="reset" value="안전 해제&#10;② 버튼 활성: 래치가 걸렸을 때&#10;(safety/status.latched)" style="rounded=1;html=1;whiteSpace=wrap;fontSize=10;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fillColor=#FFF6E5;strokeColor=#C8881E;fontFamily=Noto Sans CJK KR, Malgun Gothic, sans-serif;" vertex="1" parent="1"><mxGeometry x="900" y="552" width="300" height="88" as="geometry"/></mxCell><mxCell id="again" value="재시작 또는 새 시작" style="rounded=1;html=1;whiteSpace=wrap;fontSize=10;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fillColor=#FFFFFF;strokeColor=#8AA4C8;fontFamily=Noto Sans CJK KR, Malgun Gothic, sans-serif;" vertex="1" parent="1"><mxGeometry x="900" y="680" width="300" height="62" as="geometry"/></mxCell><mxCell id="note" value="⚠ cmd/ack(접수)와 scan/command_result(완료)는 다른 줄이다. 접수만 보고 "끝났다"로 읽으면 안 된다.&#10;버튼은 명령을 보내기만 한다 — 실행 여부는 ROS 가 정하고, 거절되면 ⑤ 와 ⑦ 에 사유가 뜬다." style="rounded=0;html=1;whiteSpace=wrap;fontSize=9;align=left;verticalAlign=top;spacingLeft=8;dashed=1;fontColor=#555555;fillColor=#F7F7F7;strokeColor=#AAAAAA;fontFamily=Noto Sans CJK KR, Malgun Gothic, sans-serif;" vertex="1" parent="1"><mxGeometry x="30" y="786" width="1200" height="66" as="geometry"/></mxCell><mxCell id="e0" value="시작 버튼" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=9;labelBackgroundColor=#FFFFFF;strokeWidth=1.5;strokeColor=#444444;fontFamily=Noto Sans CJK KR, Malgun Gothic, sans-serif;" edge="1" parent="1" source="idle" target="ack"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=9;labelBackgroundColor=#FFFFFF;strokeWidth=1.5;strokeColor=#444444;fontFamily=Noto Sans CJK KR, Malgun Gothic, sans-serif;" edge="1" parent="1" source="ack" target="run"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e2" value="정상" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=9;labelBackgroundColor=#FFFFFF;strokeWidth=1.5;strokeColor=#444444;fontFamily=Noto Sans CJK KR, Malgun Gothic, sans-serif;" edge="1" parent="1" source="run" target="done"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e3" value="중지 버튼" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=9;labelBackgroundColor=#FFFFFF;strokeWidth=1.5;strokeColor=#444444;fontFamily=Noto Sans CJK KR, Malgun Gothic, sans-serif;" edge="1" parent="1" source="run" target="stop"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e4" value="실패" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=9;labelBackgroundColor=#FFFFFF;strokeWidth=1.5;strokeColor=#444444;fontFamily=Noto Sans CJK KR, Malgun Gothic, sans-serif;" edge="1" parent="1" source="run" target="err"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e5" value="래치가 걸렸으면" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=9;labelBackgroundColor=#FFFFFF;strokeWidth=1.5;strokeColor=#444444;fontFamily=Noto Sans CJK KR, Malgun Gothic, sans-serif;" edge="1" parent="1" source="err" target="reset"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e6" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=9;labelBackgroundColor=#FFFFFF;strokeWidth=1.5;strokeColor=#444444;fontFamily=Noto Sans CJK KR, Malgun Gothic, sans-serif;" edge="1" parent="1" source="reset" target="again"><mxGeometry relative="1" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>