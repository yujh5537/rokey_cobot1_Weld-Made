        <mxCell id="c214" value="&lt;b&gt;result_store (로컬 원본)&lt;/b&gt;&lt;br/&gt;&lt;font style=&quot;font-size:13px;&quot; color=&quot;#0B5FA5&quot;&gt;&amp;lt;result_dir&amp;gt;/&amp;lt;scan_id&amp;gt;/progress.json · result.json&lt;/font&gt;&lt;br/&gt;&lt;font style=&quot;font-size:12px;&quot; color=&quot;#8A97A6&quot;&gt;tmp → fsync → replace · 재시작의 원본(웹 DB 와 구분) · 4.4.7&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F4F6F8;strokeColor=#C2CBD5;fontSize=14;fontColor=#16202B;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;strokeWidth=1.2;arcSize=4;" vertex="1" parent="1">
