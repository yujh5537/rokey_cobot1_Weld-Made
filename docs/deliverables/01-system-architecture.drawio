        <mxCell id="c218" value="&lt;b&gt;③&lt;/b&gt; TOP_SEARCH — DESCEND → CONTACT 짝 이벤트의 판정 z = 윗면 z_top (없으면 300 · 203)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#C2CBD5;strokeWidth=1.2;fontSize=14;fontColor=#16202B;align=left;verticalAlign=middle;spacingLeft=9;spacingRight=7;arcSize=4;" vertex="1" parent="1">
