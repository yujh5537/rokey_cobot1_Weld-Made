// 04-④ 1/2 scan_manager 상태기계. 원본 텍스트, png 는 figures.py 가 만든다.
// 근거: ws_cobot1/src/scan_manager/README.md "상태 기계 · 전이도 · 전이표" (state_machine.py 의 COMMAND_TRANSITIONS · SIGNAL_TRANSITIONS)
digraph sm {
  graph [rankdir=LR, fontname="Noto Sans CJK KR", fontsize=11, nodesep=0.28, ranksep=0.42, newrank=true, pad=0.1];
  node  [fontname="Noto Sans CJK KR", fontsize=11, shape=box, style="rounded,filled", fillcolor="#DCE6F5", color="#22357F", penwidth=1.4, margin="0.08,0.04"];
  edge  [fontname="Noto Sans CJK KR", fontsize=9, color="#555555", arrowsize=0.7];

  IDLE [fillcolor="#FFFFFF"];
  PREPARING [label="PREPARING\n기준점 · tare"];
  TOP [label="TOP_SEARCH\n하강 → CONTACT"];
  ESRCH [label="EDGE_SEARCH  n / 4\n+X → −X → +Y → −Y\n밀기 → EDGE"];
  GEOM [label="GEOMETRY\n5 점 → 직육면체"];
  HOMING [label="HOMING\n마무리 복귀"];
  DONE [fillcolor="#D9F2D9", color="#2E8B57"];

  STOPPING [fillcolor="#FFF5CC", color="#B8860B"];
  STOPPED [label="STOPPED\n중단 위치 · 측정값 기록", fillcolor="#FFF5CC", color="#B8860B"];
  RESUMING [label="RESUMING\n올림 · tare · 다시 닿기", fillcolor="#FFF5CC", color="#B8860B"];
  ERROR [label="ERROR\n원인 · 단계 · 위치 기록\n자동 복귀 없음", fillcolor="#FDE2E0", color="#C0392B"];

  IDLE -> PREPARING [label="START", color="#3378C8", fontcolor="#3378C8", penwidth=1.6];
  PREPARING -> TOP;
  TOP -> ESRCH [label="TOP_FOUND"];
  ESRCH -> ESRCH [label="EDGE_FOUND (n < 4)\n방향 전환"];
  ESRCH -> GEOM [label="4 / 4"];
  GEOM -> HOMING;
  HOMING -> DONE;

  ESRCH -> STOPPING [label="STOP (어느 동작 중이든)", color="#B8860B", fontcolor="#8B6508", penwidth=1.4];
  STOPPING -> STOPPED [label="정지 확인\n(/robot/status)", color="#B8860B", fontcolor="#8B6508"];
  STOPPED -> RESUMING [label="RESUME", color="#3378C8", fontcolor="#3378C8", penwidth=1.6];
  RESUMING -> ESRCH [label="중단됐던 단계로\n(확정값은 다시 안 잰다)", color="#3378C8", fontcolor="#3378C8", style=dashed];
  TOP -> ERROR [label="FAILED", color="#C0392B", fontcolor="#C0392B"];
  ESRCH -> ERROR [label="FAILED (어느 동작 중이든)", color="#C0392B", fontcolor="#C0392B"];

  HOMEBOX [shape=note, fillcolor="#FFFFFF", color="#888888", fontsize=9.5, label="안전복귀 (HOME)\n휴지 상태(IDLE · DONE · ERROR · STOPPED)에서만\n→ HOMING → 출발했던 상태로\n\n세 명령은 서로 부르지 않는다:\nSTOP ↛ HOME · RESUME,  FAILED ↛ HOME"];

  {rank=same; STOPPING; STOPPED; RESUMING;}
  {rank=same; ESRCH; ERROR;}
  {rank=same; DONE; HOMEBOX;}
}
